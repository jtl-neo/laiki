# Ports
WEB_PORT=28080
SERVER_PORT=18081

# DB
POSTGRES_USER=laiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=laiki
DATABASE_URL=postgres://laiki:change-me@db:5432/laiki

# LINE Messaging API channel (Bot)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_BASIC_ID=@laiki

# LINE Login channel (LIFF host — separate Login channel, same provider)
# See https://developers.line.biz/en/news/2019/11/11/liff-cannot-be-used-with-messaging-api-channels/
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
LIFF_ID_APIKEY=

# Gemini (platform default key, used when user has no BYOK)
GEMINI_API_KEY=
GEMINI_PARSE_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash

# BYOK encryption (32 bytes base64, AES-256-GCM)
APIKEY_ENC_KEY=

# Public URLs
PUBLIC_BASE=https://laiki.heyinna.com
LIFF_BASE=https://liff.laiki.heyinna.com
ALLOWED_ORIGINS=https://liff.line.me,https://liff.laiki.heyinna.com

NODE_ENV=development
